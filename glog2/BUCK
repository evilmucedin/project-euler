cxx_library(
  name="glog",
  exported_preprocessor_flags=[
    "-Iglog2/src",
    "-DGLOG_DEPRECATED=__attribute__((deprecated))",
    "-DGLOG_EXPORT=__attribute__((visibility(\"default\")))",
    "-DGLOG_NO_EXPORT=__attribute__((visibility(\"default\")))",
    # Use gflags for FLAGS_logtostderr & co. instead of glog's own copies,
    # which would clash with gflags in programs that use both.
    "-DGLOG_USE_GFLAGS",
  ],
  compiler_flags=[
    "-Iglog2/src",
    "-Wno-sign-compare",
    "-Wno-unused-function",
    "-Wno-unused-local-typedefs",
    "-Wno-unused-variable",
    "-DHAVE_SYS_UTSNAME_H",
    "-DHAVE_SYS_TIME_H",
    "-DHAVE_UNWIND",
    "-DHAVE_SIGACTION",
    "-DHAVE_PREAD",
    "-DHAVE_MODE_T",
    "-DHAVE_UNISTD_H",
    "-DHAVE_POSIX_FADVISE",
    "-DHAVE_SSIZE_T",
    "-DHAVE_SYS_TYPES_H",
    "-DHAVE_SYS_SYSCALL_H",
    "-DHAVE_EXECINFO_H",
    "-fvisibility-inlines-hidden",
    "-fvisibility=hidden",
  ],
  # Consumers include these as <glog/logging.h> etc.
  header_namespace="glog",
  exported_headers={
    "flags.h": "src/glog/flags.h",
    "log_severity.h": "src/glog/log_severity.h",
    "logging.h": "src/glog/logging.h",
    "platform.h": "src/glog/platform.h",
    "raw_logging.h": "src/glog/raw_logging.h",
    "stl_logging.h": "src/glog/stl_logging.h",
    "types.h": "src/glog/types.h",
    "vlog_is_on.h": "src/glog/vlog_is_on.h",
  },
  headers=[
    "src/config.h",
    "src/stacktrace_generic-inl.h",
    "src/stacktrace_libunwind-inl.h",
    "src/stacktrace_powerpc-inl.h",
    "src/stacktrace_unwind-inl.h",
    "src/stacktrace_x86-inl.h",
    "src/base/commandlineflags.h",
    "src/base/googleinit.h",
    "src/demangle.h",
    "src/stacktrace.h",
    "src/symbolize.h",
    "src/utilities.h",
  ],
  srcs=[
    "src/demangle.cc",
    "src/flags.cc",
    "src/logging.cc",
    "src/raw_logging.cc",
    "src/signalhandler.cc",
    "src/stacktrace.cc",
    "src/symbolize.cc",
    "src/utilities.cc",
    "src/vlog_is_on.cc",
  ],
  exported_deps=[
    "//gflags:gflags",
  ],
  visibility=[
    "PUBLIC",
  ],
)
