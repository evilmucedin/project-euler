cxx_library(
    name="eigen",
    # Every module header plus all of src/, including the per-architecture
    # (SSE, AVX, NEON, ...) packet math that Eigen picks at compile time.
    exported_headers=glob(
        ["*", "src/**/*.h"],
        exclude=["BUCK", "BUILD", "build.ninja", "tests"],
    ),
    visibility=[
        "PUBLIC",
    ],
)
